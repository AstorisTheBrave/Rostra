		"@rostra/web-client": "workspace:*",
		"bullmq": "^5.79.2",
		"fastify": "^5.12.1",
		"ioredis": "^5.4.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2"
