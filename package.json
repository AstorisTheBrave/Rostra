{
	"name": "rostra",
	"version": "0.1.2",
	"description": "All-in-one Discord bot",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/cluster.ts",
		"build": "turbo run build legacy:build",
		"legacy:build": "tsc --noEmit",
		"start": "tsx src/cluster.ts",
		"start:panel": "node panel-start.mjs",
		"typecheck": "turbo run typecheck legacy:typecheck",
		"legacy:typecheck": "tsc --noEmit",
		"check:boundaries": "node tooling/scripts/check-repository-boundaries.mjs && node tooling/scripts/verify-workspace.mjs",
		"lint": "turbo run lint legacy:lint",
		"legacy:lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "turbo run test legacy:test",
		"legacy:test": "node --import tsx --test --test-concurrency=2 \"src/**/*.test.ts\" \"tooling/**/*.test.ts\"",
		"test:env": "node --import tsx --env-file=.env --test --test-concurrency=2 \"src/**/*.test.ts\" \"tooling/**/*.test.ts\"",
		"test:integration": "turbo run test:integration",
		"clean": "turbo run clean legacy:clean && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.turbo', { recursive: true, force: true });\"",
		"legacy:clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'build', 'coverage']) rmSync(path, { recursive: true, force: true });\"",
		"deploy:commands": "node --import tsx --env-file-if-exists=.env src/scripts/deploy-commands.ts",
		"lavalink:check": "node --import tsx --env-file-if-exists=.env src/scripts/lavalink-check.ts",
		"emojis:generate": "node --import tsx src/scripts/generate-emojis.ts",
		"emojis:upload": "node --import tsx --env-file-if-exists=.env src/scripts/upload-emojis.ts",
		"prisma:generate": "prisma generate --config tooling/prisma-generate.config.ts",
		"prisma:migrate": "prisma migrate deploy",
		"i18n:bundle": "node --import tsx src/scripts/i18n-bundle.ts",
		"i18n:coverage": "node --import tsx --env-file-if-exists=.env src/scripts/i18n-coverage.ts",
		"i18n:push": "node --import tsx --env-file-if-exists=.env src/scripts/i18n-push.ts",
		"i18n:validate": "node --import tsx --env-file-if-exists=.env src/scripts/i18n-validate.ts",
		"i18n:draft": "node --import tsx --env-file-if-exists=.env src/scripts/i18n-draft.ts"
	},
	"dependencies": {
		"@fastify/rate-limit": "^11.1.0",
		"@keyv/redis": "^5.1.6",
		"@napi-rs/canvas": "^1.0.2",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@top-gg/sdk": "^3.1.6",
		"bad-words": "^4.0.0",
		"bullmq": "^5.79.2",
		"discord-hybrid-sharding": "^3.0.1",
		"discord.js": "^14.16.3",
		"fastify": "^5.12.1",
		"intl-messageformat": "^11.2.9",
		"ioredis": "^5.4.1",
		"keyv": "^5.2.1",
		"lavalink-client": "^2.10.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.0.0",
		"tsx": "^4.23.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "^26.1.0",
		"dotenv": "^17.2.3",
		"lucide-static": "^1.23.0",
		"prisma": "^7.9.1",
		"turbo": "2.11.9",
		"typescript": "^7.0.2"
	}
}
