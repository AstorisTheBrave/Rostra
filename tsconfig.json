{
	"extends": "./tooling/typescript/node.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": ".",
		"paths": {
			"@/modules/*": ["./modules/*"],
			"@/*": ["./apps/gateway/src/*"]
		}
	},
	"include": ["apps/gateway/src/**/*.ts", "modules/**/*.ts", "tooling/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"archive",
		"Archive",
		".superpowers",
		"coverage",
		"secrets"
	]
}
