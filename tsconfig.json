{
	"extends": "./tooling/typescript/node.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": ".",
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "prisma/**/*.ts", "tooling/**/*.ts"],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"archive",
		"Archive",
		".superpowers",
		"coverage",
		"secrets"
	]
}
